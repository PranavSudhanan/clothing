# ─── Database ────────────────────────────────────────────────────────────────
# Neon connection string (use the *pooled* one). Leave empty for local
# development: the app then uses an embedded Postgres stored in ./.data
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Long random string used to sign login sessions.  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# First admin account. Created automatically when no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Image uploads (optional) ────────────────────────────────────────────────
# Vercel → Storage → Blob → connect to this project. Without it, uploads are
# saved to ./.data/uploads (fine locally, not available on Vercel).
BLOB_READ_WRITE_TOKEN=

# ─── Online payments (optional) ──────────────────────────────────────────────
# Razorpay API keys. Without them only Cash on Delivery is offered.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional safety net: add a Razorpay webhook (event: payment.captured) pointing at
# https://your-domain/api/razorpay/webhook and put its secret here.
RAZORPAY_WEBHOOK_SECRET=

# ─── Emails (order confirmation, shipping update, password reset) ───────────
# Any SMTP provider works. Examples:
#   Gmail  : smtp.gmail.com, port 465, user = your address, pass = an App Password
#   Zoho   : smtp.zoho.in, port 465
#   Brevo  : smtp-relay.brevo.com, port 587
#   Resend : smtp.resend.com, port 465, user = resend, pass = your API key
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The sender customers see, e.g.  Atelier <orders@yourbrand.com>
EMAIL_FROM=
# Optional: where replies should go if different from EMAIL_FROM
EMAIL_REPLY_TO=

# ─── Text messages (optional) ───────────────────────────────────────────────
# Option A — Twilio (SMS, and WhatsApp if you add the WhatsApp sender)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number (+1415…) or a Messaging Service id (MG…)
TWILIO_SMS_FROM=
# e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Option B — MSG91 (India). Each message needs a DLT-approved template whose variables are
# ##store## ##name## ##order## ##amount## ##link## ##tracking##
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ORDER_PLACED=
MSG91_TEMPLATE_ORDER_SHIPPED=
MSG91_TEMPLATE_ORDER_DELIVERED=
MSG91_TEMPLATE_ORDER_CANCELLED=
MSG91_TEMPLATE_COUTURE_RECEIVED=

# ─── Site URL (optional) ─────────────────────────────────────────────────────
# Your live address, e.g. https://www.yourbrand.com. Used for links inside emails and
# text messages, the sitemap and social previews. Set it once your domain is connected.
NEXT_PUBLIC_SITE_URL=
