# ─── Database ────────────────────────────────────────────────────────────────
# Neon connection string (use the *pooled* one). Leave empty for local
# development: the app then uses an embedded Postgres stored in ./.data
DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Long random string used to sign login sessions.  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# First admin account. Created automatically when no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Image uploads (optional) ────────────────────────────────────────────────
# Vercel → Storage → Blob → connect to this project. Without it, uploads are
# saved to ./.data/uploads (fine locally, not available on Vercel).
BLOB_READ_WRITE_TOKEN=

# ─── Online payments (optional) ──────────────────────────────────────────────
# Razorpay API keys. Without them only Cash on Delivery is offered.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional safety net: add a Razorpay webhook (event: payment.captured) pointing at
# https://your-domain/api/razorpay/webhook and put its secret here.
RAZORPAY_WEBHOOK_SECRET=

# ─── Site URL (optional) ─────────────────────────────────────────────────────
# Used for canonical links and social previews, e.g. https://www.yourbrand.com
NEXT_PUBLIC_SITE_URL=
